.price-list {
    padding: 35px 0
}

.price-list .text-h2,.h2 {
    font-weight: 300
}

.price-list .content {
    position: relative;
    padding: 35px 38px;
    color: #fff;
    background: var(--orange);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0
}

.price-list .content:before {
    content: "";
    position: absolute;
    top: calc(50% - 5px);
    right: 75px;
    transform: translateY(-50%);
    width: 255px;
    height: 320px;
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/price-list.png) center/contain no-repeat;
    filter: drop-shadow(0 0 31px rgba(0, 0, 0, .15));
    z-index: 2
}

.price-list .content:after {
    content: "";
    position: absolute;
    top: calc(50% + 10px);
    right: 60px;
    transform: translateY(-50%);
    width: 255px;
    height: 320px;
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/price-list.png) center/contain no-repeat;
    filter: drop-shadow(0 0 31px rgba(0, 0, 0, .15))
}

.price-list p {
    margin: 12px 0 18px
}

.price-list .btn {
    padding: 10px 20px;
    color: var(--orange);
    font-size: 16px;
    font-weight: 300;
    background: #fff;
    border-radius: 15px
}

@media screen and (max-width: 1024px) {
