.article li {
    display: flex;
    gap: 5px;
    align-items: center;
}
.article li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #000;
}
.article .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px
}

.article__dropdown {
    position: relative;
    width: 100%;
    height: auto;
    max-height: 100px;
    transition: .3s ease-in;
    overflow: hidden
}

.article__dropdown:before {
    position: absolute;
    content: "";
    bottom: 0;
    left: 0;
    height: 50%;
    width: 100%;
    background: linear-gradient(to top, #fff, transparent);
}

.article__dropdown.active:before {
    display: none
}

.article__dropdown-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px
}
.article h1 {
    color: #d99550;
    font-size: 36px;
    color:#202020;
    font-weight: 700;   
}
.article h2 {
    color: #d99550;
