<style id="main-style-css">@font-face {
    font-family: Open Sans;
    src: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-Light.woff2) format("woff2"), url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-Light.ttf) format("truetype");
    font-weight: 300;
    font-display: swap;
    font-style: normal
}

@font-face {
    font-family: Open Sans;
    src: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-Regular.woff2) format("woff2"), url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-Regular.ttf) format("truetype");
    font-weight: 400;
    font-display: swap;
    font-style: normal
}

@font-face {
    font-family: Open Sans;
    src: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-Medium.woff2) format("woff2"), url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-Medium.ttf) format("truetype");
    font-weight: 500;
    font-display: swap;
    font-style: normal
}

@font-face {
    font-family: Open Sans;
    src: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-SemiBold.woff2) format("woff2"), url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-SemiBold.ttf) format("truetype");
    font-weight: 600;
    font-display: swap;
    font-style: normal
}

@font-face {
    font-family: Open Sans;
    src: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-Bold.woff2) format("woff2"), url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/fonts/OpenSans-Bold.ttf) format("truetype");
    font-weight: 700;
    font-display: swap;
    font-style: normal
}

:root {
    --font-primary: "Open Sans", sans-serif;
    --text-color: #3a3a3a;
    --primary: #4eac4c;
    --primary-light: #33d22f;
    --cyan: #4caca6;
    --orange: #f9a04e;
    --brown: #cd6022;
    --gray: #d9d9d9;
    --transition: all .3s ease-in-out
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth
}

body {
    color: var(--text-color);
    font-family: var(--font-primary);
    line-height: inherit
}

body.overflow-hidden {
    overflow: hidden
}

main {
    margin: 0 auto;
    width: 100%;
    max-width: 100%
}

abbr:where([title]) {
    -webkit-text-decoration: underline dotted;
    text-decoration: underline dotted
}

h1,
h2,
h3,
h4,
h5,
h6 {
    font-size: inherit;
    font-weight: inherit
}

a {
    color: inherit;
    text-decoration: inherit
}

b,
strong {
    font-weight: bolder
}

code,
kbd,
pre,
samp {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace;
    font-size: 1em
}

small {
    font-size: 80%
}

sub,
sup {
    font-size: 75%;
    line-height: 0;
    position: relative;
    vertical-align: baseline
}

sub {
    bottom: -.25em
}

sup {
    top: -.5em
}

table {
    text-indent: 0;
    border-color: inherit;
    border-collapse: collapse
}

button,
input,
optgroup,
select,
textarea {
    font-family: inherit;
    font-weight: inherit;
    line-height: inherit;
    color: inherit;
    outline: none;
    border: none;
    background: transparent
}

button,
select {
    text-transform: none
}

[type=button],
[type=reset],
[type=submit],
button {
    -webkit-appearance: button;
    -moz-appearance: button;
    appearance: button;
    background-color: transparent;
    background-image: none
}

:-moz-focusring {
    outline: auto
}

:-moz-ui-invalid {
    box-shadow: none
}

progress {
    vertical-align: baseline
}

::-webkit-inner-spin-button,
::-webkit-outer-spin-button {
    height: auto
}

[type=search] {
    -webkit-appearance: textfield;
    -moz-appearance: textfield;
    appearance: textfield;
    outline-offset: -2px
}

::-webkit-search-decoration {
    -webkit-appearance: none
}

::-webkit-file-upload-button {
    -webkit-appearance: button;
    font: inherit
}

summary {
    display: list-item
}

menu,
ol,
ul {
    list-style: none
}

textarea {
    resize: vertical
}

input::-moz-placeholder,
textarea::-moz-placeholder {
    opacity: 1;
    color: #9ca3af
}

input:-ms-input-placeholder,
textarea:-ms-input-placeholder {
    opacity: 1;
    color: #9ca3af
}

input::placeholder,
textarea::placeholder {
    opacity: 1;
    color: #9ca3af
}

[role=button],
button {
    cursor: pointer
}

:disabled {
    cursor: default
}

audio,
canvas,
embed,
iframe,
img,
object,
svg,
video {
    display: block
}

img,
video {
    max-width: 100%;
    height: auto
}

hr {
    border: none;
    outline: none
}

[hidden],
.hidden {
    display: none
}

.container {
    padding: 0 16px;
    margin: 0 auto;
    width: 100%;
    max-width: 1372px
}

.col {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start
}

.row {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: flex-start
}

@media screen and (max-width: 1380px) {
    .container {
        max-width: 1180px
    }
}

@media screen and (max-width: 1280px) {
    .container {
        max-width: 1024px
    }
}

@media screen and (max-width: 1024px) {
    .container {
        max-width: 768px
    }
}

@media screen and (max-width: 768px) {
    .container {
        max-width: 640px
    }
}

@media screen and (max-width: 640px) {
    .container {
        max-width: 475px
    }
}

.font-light {
    font-weight: 300
}

.font-regular {
    font-weight: 400
}

.font-medium {
    font-weight: 500
}

.font-semibold {
    font-weight: 600
}

.font-bold {
    font-weight: 700
}

.font-extrabold {
    font-weight: 800
}

.uppercase {
    text-transform: uppercase
}

.lowercase {
    text-transform: lowercase
}

.underline {
    text-decoration: underline
}

.line-through {
    text-decoration: line-through
}

.text-left {
    text-align: left
}

.text-center {
    text-align: center
}

.text-right {
    text-align: right
}

.text-primary {
    color: var(--primary)
}

.text-gray {
    color: var(--gray, #808080)
}

.text-white {
    color: #fff
}

.text-black {
    color: #000
}

.text-xs {
    font-size: .75rem
}

.text-sm {
    font-size: .875rem
}

.text-base {
    font-size: 1rem
}

.text-lg {
    font-size: 1.125rem
}

.text-xl {
    font-size: 1.25rem
}

.text-2xl {
    font-size: 1.5rem
}

.text-h2,.h2 {
    font-size: 32px;
    font-weight: 700
}

.text-h3 {
    color: var(--primary);
    font-size: 24px;
    font-weight: 700
}

@media screen and (max-width: 768px) {
    .text-h2,.h2 {
        font-size: 24px
    }
}

@media screen and (max-width: 640px) {
    .text-h2,.h2 {
        font-size: 20px
    }
}

@media screen and (min-width: 641px) {
    .sm\:hidden {
        display: none
    }
}

.bg-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1
}

.bg-img img {
    width: 100%;
    height: 100%;
    -o-object-fit: cover;
    object-fit: cover
}

.icon {
    min-width: var(--icon-size, 24px);
    width: var(--icon-size, 24px);
    height: var(--icon-size, 24px)
}

.icon svg,
.icon img {
    width: 100%;
    height: 100%
}

.icon img {
    -o-object-fit: contain;
    object-fit: contain
}

.btn {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    font-size: 16px;
    transition: var(--transition);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0px
}

.popup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    display: none;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    z-index: 100;
    transform: scale(.85);
    opacity: 0;
    transition: var(--transition)
}

.popup__close {
    position: absolute;
    right: 60px;
    top: 40px;
    color: #fff;
    cursor: pointer;
    z-index: 2
}

.popup__close svg {
    width: 32px;
    height: 32px
}

.popup--form {
    background: var(--primary)
}

.popup--form:before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 35%;
    height: 100%;
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/popup-bg.png) center/cover
}

.popup--form .popup__content {
    margin-left: 15%;
    width: 480px;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 14px
}

.popup--form .popup__form {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 14px
}

.popup--form .popup__form .col {
    margin-top: 16px;
    width: 100%;
    max-width: 430px;
    gap: 15px
}

.popup--form .popup__form input {
    padding: 14px 18px;
    width: 100%;
    height: 50px;
    color: #000;
    font-size: 16px;
    background: #f6f6f6;
    border-radius: 15px
}

.popup--form .popup__form button {
    padding: 14px 25px;
    margin-top: 15px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 15px;
    background: var(--brown)
}

.popup--form .popup__success {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 14px;
    display: none
}

.popup--form .popup__success img {
    width: 300px;
    transform: rotate(15deg)
}

@media screen and (min-width: 1281px) {
    .popup--form .text-h2,.h2 {
        font-size: 36px
    }
}

@media screen and (max-width: 1180px) {
    .popup--form .popup__content {
        margin-left: 30%
    }
}

@media screen and (max-width: 880px) {
    .popup--form:before {
        width: 25%
    }

    .popup--form .popup__content {
        margin-left: 25%
    }
}

@media screen and (max-width: 640px) {
    .popup--form:before {
        width: 100%;
        opacity: .5
    }

    .popup--form .popup__close {
        top: 20px;
        right: 20px
    }

    .popup--form .popup__close svg {
        width: 24px;
        height: 24px
    }

    .popup--form .popup__content {
        position: relative;
        margin-left: 0;
        padding: 0 16px;
        font-size: 14px
    }

    .popup--form .popup__content .text-h2,.h2 {
        font-size: 24px
    }

    .popup--form .popup__form .col {
        gap: 12px
    }

    .popup--form .popup__form input {
        padding: 0 15px;
        height: 42px;
        font-size: 14px
    }

    .popup--form .popup__form button {
        margin-top: 10px;
        padding: 10px 20px;
        font-size: 14px
    }

    .popup--form .popup__success img {
        margin-left: 20px;
        width: 80%;
        height: auto;
        transform: rotate(10deg)
    }
}

.popup--map {
    background: #000000af
}

.popup--map .popup__close {
    position: absolute
}

.popup--map iframe {
    width: 980px;
    max-width: calc(100vw - 40px);
    height: 580px;
    max-height: 70vh;
    border: none
}

@media screen and (max-width: 640px) {
    .popup--map .popup__close {
        top: 20px;
        right: 20px
    }

    .popup--map .popup__close svg {
        width: 24px;
        height: 24px
    }

    .popup--map iframe {
        max-width: calc(100vw - 32px);
        height: 80vh;
        max-height: 100%
    }
}

.header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    transition: var(--transition);
    z-index: 9
}

.header__top {
    height: 60px;
    width: 100%;
    color: #fff;
    background: var(--primary)
}

.header__top .container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 24px
}

.header__top .menu {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 50px
}

.header__top .socials {
    margin-left: auto;
    margin-right: 30px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 15px
}

.header__top .pickup {
    padding: 0 15px;
    width: 100%;
    max-width: 545px;
    height: 100%;
    background: var(--primary-light);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 15px
}

.header__nav {
    padding: 25px 0;
    height: 115px;
    width: 100%;
    transition: var(--transition)
}

.header__nav .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 24px
}

.header__nav .container>.menu {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 50px;
    display: none
}

.header__nav .container>.menu a {
    transition: var(--transition)
}

.header__nav .container>.menu a:hover {
    color: var(--primary)
}

.header__nav-logo {
    height: 35px
}

.header__nav-logo img {
    height: 100%;
    width: auto
}

.header__nav-btn {
    position: relative
}

.header__nav-btn .row {
    padding: 0 25px;
    height: 42px;
    width: 300px;
    color: #fff;
    background: var(--primary);
    border-radius: 25px;
    cursor: pointer;
    align-items: center
}

.header__nav-btn .row span {
    margin: 0 auto
}

.header__nav-btn .categories {
    position: absolute;
    top: calc(100% + 20px);
    transform-origin: top;
    display: none
}

.header__nav-search {
    padding: 4px;
    width: 370px;
    height: 45px;
    border: 1px solid var(--gray);
    border-radius: 25px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 0px
}

.header__nav-search .row {
    padding: 0 20px;
    flex-grow: 1;
    align-items: center;
    gap: 12px
}

.header__nav-search input {
    flex-grow: 1;
    font-size: 15px
}

.header__nav-search button {
    width: 110px;
    height: 100%;
    font-size: 15px;
    background: var(--gray);
    border-radius: 25px
}

.header__nav-contacts {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0
}

.header__nav-contacts .text-sm {
    color: #585858
}

@media screen and (max-width: 1380px) {
    .header__top .socials {
        display: none
    }

    .header__top .pickup {
        margin-left: auto
    }

    .header__nav .container {
        gap: 24px
    }

    .header__nav-btn .row {
        width: 240px
    }

    .header__nav-search {
        width: 320px
    }
}

@media screen and (max-width: 1280px) {
    .header {
        position: absolute
    }

    .header__top .menu {
        display: none
    }

    .header__top .pickup {
        width: 100%;
        max-width: 100%
    }

    .header__nav {
        padding: 15px 0;
        height: auto
    }

    .header__nav-btn,
    .header__nav-search {
        display: none
    }
}

@media screen and (max-width: 640px) {
    .header__top {
        padding: 14px 0;
        height: auto;
        background: var(--primary-light)
    }

    .header__top .pickup {
        padding: 0
    }

    .header__nav {
        padding: 24px 0 !important
    }

    .header__nav .container {
        justify-content: center
    }

    .header__nav-logo {
        height: 32px
    }

    .header__nav-contacts {
        display: none !important
    }
}

.mobile__tabs {
    position: fixed;
    bottom: 0;
    left: 0;
    height: 65px;
    width: 100%;
    box-shadow: 0 -4px 29px #00000026;
    background: #fff;
    z-index: 10;
    display: none
}

.mobile__tabs .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 15px
}

.mobile__tabs-tab {
    position: relative;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    --icon-size: 32px
}

.mobile__tabs-tab:last-child {
    position: relative;
    width: 80px;
    height: 100px;
    color: #fff;
    background: var(--primary);
    border-radius: 16px 16px 0 0;
    transform: translateY(-10px);
    z-index: 2;
    --icon-size: 24px
}

.mobile__tabs .categories {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, calc(-50vh + 50%));
    width: 480px;
    z-index: 2
}

.mobile__tabs .socials {
    position: absolute;
    bottom: 80px;
    left: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px
}

.mobile__tabs .socials a {
    width: 56px;
    height: 56px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0;
    border-radius: 50%;
    transition: var(--transition);
    opacity: 0;
    display: none
}

@media screen and (max-width: 1280px) {
    .mobile__tabs {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0px
    }
}

@media screen and (max-width: 380px) {
    .mobile__tabs-tab {
        gap: 2px;
        --icon-size: 28px
    }

    .mobile__tabs-tab:last-child {
        width: 80px;
        height: 85px
    }
}

@media screen and (max-width: 350px) {
    .mobile__tabs-tab {
        gap: 2px;
        --icon-size: 24px
    }

    .mobile__tabs-tab:last-child {
        width: 80px;
        height: 85px
    }

    .mobile__tabs-tab .text-xs {
        font-size: 11px
    }
}

.mobile__categories {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #ffffff40;
    display: none;
    z-index: 9
}

.mobile__categories.active {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0
}

.mobile__categories-content {
    position: relative;
    width: 480px
}

.mobile__categories-close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 3;
    cursor: pointer
}

.mobile__categories .menu {
    padding: 35px;
    width: 100%;
    color: #fff;
    background: var(--primary);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 15px
}

.mobile__categories .menu .menu-item:hover>a:after {
    opacity: 1
}

.mobile__categories .menu a {
    position: relative
}

.mobile__categories .menu a:after {
    position: relative;
    content: "";
    transform: translate(10px, 5px);
    width: 28px;
    height: 20px;
    display: inline-block;
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/arrow-right.svg) center/contain no-repeat;
    transition: .2s ease-in-out;
    opacity: 0
}

.mobile__categories .menu>.menu-item {
    position: relative;
    width: 100%
}

.mobile__categories .menu>.menu-item>a {
    position: relative;
    padding-left: 35px
}

.mobile__categories .menu>.menu-item>a:before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 25px;
    height: 25px
}

.mobile__categories .menu>.menu-item:nth-child(1)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/healthy-food.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item:nth-child(2)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/wheat.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item:nth-child(3)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/molochniye-producti.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item:nth-child(4)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/soleniya.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item:nth-child(5)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/gribi.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item:nth-child(6)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/moreproductki.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item:nth-child(7)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/zamorzka.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item:nth-child(8)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/meat.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item:nth-child(9)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/kolbasi.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item:nth-child(10)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/egg.svg) center/contain no-repeat
}

.mobile__categories .menu>.menu-item>.sub-menu {
    display: none
}

@media screen and (max-width: 640px) {
    .mobile__categories-content {
        width: 100%;
        max-width: calc(100vw - 32px)
    }
}

.header-sticky {
    transform: translateY(-60px)
}

.header-sticky .header__nav {
    padding: 15px 0;
    height: auto;
    background: #fff
}

.header-sticky .header__nav-btn .row {
    width: 225px
}

.header-sticky .header__nav-search {
    display: none
}

.header-sticky .header__nav .container>.menu {
    display: flex
}

@media screen and (max-width: 1380px) {
    .header-sticky .header__nav-contacts {
        display: none
    }
}

@media screen and (max-width: 1280px) {
    .header-sticky {
        transform: translateY(0)
    }

    .header-sticky .header__nav .menu {
        display: none !important
    }

    .header-sticky .header__nav-contacts {
        display: flex
    }
}

.footer {
    padding: 70px 0 45px;
    width: 100%;
    color: #fff;
    background: #212121
}

.footer__content {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px
}

.footer__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 18px
}

.footer__item:nth-child(1) {
    gap: 0
}

.footer__item:nth-child(1)>.font-light {
    margin: 10px 0 24px
}

.footer__item:last-child .col {
    gap: 25px
}

.footer__item ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px
}

.footer__item .btn {
    padding: 10px 25px;
    width: -webkit-fit-content;
    width: -moz-fit-content;
    width: fit-content;
    border-radius: 15px;
    border: 1px solid #fff;
    gap: 10px
}

.footer__bottom {
    margin-top: 34px;
    width: 100%
}

.footer__bottom .row {
    align-items: center;
    gap: 12px
}

@media screen and (max-width: 1280px) {
    .footer {
        padding-bottom: 110px
    }

    .footer__content {
        flex-wrap: wrap;
        gap: 60px 40px
    }

    .footer__item {
        flex-basis: 240px
    }
}

@media screen and (max-width: 1024px) {
    .footer__item {
        flex-grow: 1;
        flex-basis: 220px
    }

    .footer__item:nth-child(1) {
        flex-basis: 100%
    }
}

@media screen and (max-width: 640px) {
    .footer {
        padding-top: 35px
    }

    .footer__content {
        flex-direction: column;
        gap: 25px
    }

    .footer__item {
        flex-basis: auto
    }

    .footer__item:nth-child(2) {
        display: none
    }

    .footer__bottom .row {
        justify-content: center
    }
}

.categories {
    position: relative;
    padding: 38px 35px;
    width: 300px;
    color: #fff;
    background: var(--primary);
    border-radius: 20px;
    z-index: 2
}

.categories .menu {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 15px
}

.categories .menu .menu-item:hover>a:after {
    opacity: 1
}

.categories .menu a {
    position: relative
}

.categories .menu a:after {
    position: relative;
    content: "";
    transform: translate(10px, 5px);
    width: 28px;
    height: 20px;
    display: inline-block;
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/arrow-right.svg) center/contain no-repeat;
    transition: .2s ease-in-out;
    opacity: 0
}

.categories .menu>.menu-item {
    position: relative;
    width: 100%;
    cursor: pointer
}

.categories .menu>.menu-item>a {
    position: relative;
    padding-left: 35px
}

.categories .menu>.menu-item>a:before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 25px;
    height: 25px
}

.categories .menu>.menu-item:nth-child(1)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/healthy-food.svg) center/contain no-repeat
}

.categories .menu>.menu-item:nth-child(2)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/wheat.svg) center/contain no-repeat
}

.categories .menu>.menu-item:nth-child(3)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/molochniye-producti.svg) center/contain no-repeat
}

.categories .menu>.menu-item:nth-child(4)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/soleniya.svg) center/contain no-repeat
}

.categories .menu>.menu-item:nth-child(5)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/gribi.svg) center/contain no-repeat
}

.categories .menu>.menu-item:nth-child(6)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/moreproductki.svg) center/contain no-repeat
}

.categories .menu>.menu-item:nth-child(7)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/zamorzka.svg) center/contain no-repeat
}

.categories .menu>.menu-item:nth-child(8)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/meat.svg) center/contain no-repeat
}

.categories .menu>.menu-item:nth-child(9)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/kolbasi.svg) center/contain no-repeat
}

.categories .menu>.menu-item:nth-child(10)>a:before {
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/icons/egg.svg) center/contain no-repeat
}

.categories .menu>.menu-item:hover>.sub-menu {
    display: flex;
    transform-origin: top;
    animation: showCatalog .3s ease-in-out
}

.categories .menu>.menu-item .sub-menu {
    position: absolute;
    padding: 25px 0;
    top: 0;
    left: calc(100% + 50px);
    min-width: 220px;
    background: var(--primary);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 10px;
    display: none
}

.categories .menu>.menu-item .sub-menu:before {
    position: absolute;
    content: "";
    top: 0;
    left: 0;
    transform: translate(-100%);
    height: 100%;
    width: 75px;
    cursor: pointer
}

.categories .menu>.menu-item .sub-menu .menu-item {
    padding: 0 25px
}

.categories .menu>.menu-item .sub-menu .menu-item .sub-menu {
    left: calc(100% + 10px)
}

.categories .menu>.menu-item .sub-menu .menu-item .sub-menu:before {
    width: 50px
}

.categories .menu>.menu-item .sub-menu .menu-item:hover .sub-menu {
    display: flex;
    transform-origin: top;
    animation: showCatalog .3s ease-in-out
}

.categories .menu>.menu-item .sub-menu>.menu-item {
    width: 100%
}

.categories .menu>.menu-item .sub-menu>.menu-item>a {
    position: relative
}

.aside {
    position: -webkit-sticky;
    position: sticky;
    top: 100px;
    width: 300px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px
}

.aside .menu {
    gap: 25px
}

.aside__banner {
    position: relative;
    padding: 14px 24px 24px;
    width: 100%;
    color: #4b4b4b;
    background: #f0f0f0;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 15px
}

.aside__banner:before {
    content: "";
    position: absolute;
    bottom: 0;
    right: 0;
    width: 140px;
    height: 115px;
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/korzinka.webp) center/cover no-repeat
}

.top {
    position: relative;
    padding-bottom: 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 2px solid #e0e0e0
}

.top:before {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 85px;
    height: 2px;
    background: var(--primary)
}

.top__btns {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px
}

.top__btns>div {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--primary);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0;
    cursor: pointer
}

.top__btns>div svg path {
    stroke: #fff
}

.top__btns>div.swiper-button-disabled {
    background: #e0e0e0
}

.top__btns>div.swiper-button-disabled svg path {
    stroke: #585858
}

@media screen and (max-width: 640px) {
    .top__btns {
        gap: 15px
    }

    .top__btns>div {
        min-width: 25px;
        width: 25px;
        height: 25px
    }

    .top__btns>div svg {
        width: 10px;
        height: 10px
    }
}

.intro {
    padding: 200px 0 35px
}

.intro .container {
    display: flex;
    align-items: stretch;
    gap: 40px
}

.intro__content {
    width: calc(100% - 340px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 35px
}

.intro .swiper {
    position: relative;
    flex-grow: 1;
    min-height: 215px;
    width: 100%;
    background: #ebfaeb;
    border-radius: 25px;
    overflow: hidden;
    cursor: grab
}

.intro .swiper-slide {
    position: relative;
    padding: 35px;
    height: 100%;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0
}

.intro .swiper-pagination {
    width: auto;
    height: auto;
    left: 35px;
    bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 7px
}

.intro .swiper-pagination-bullet {
    margin: 0 !important;
    width: 14px;
    height: 14px;
    background: var(--gray);
    opacity: 1
}

.intro .swiper-pagination-bullet-active {
    background: var(--primary)
}

.intro__title {
    width: 100%;
    max-width: 580px;
    font-size: 40px;
    font-weight: 700
}

.intro__title .text-primary {
    font-size: 64px
}

.intro__bottom {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px
}

.intro__bottom-item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 30px;
    --icon-size: 60px
}

@media screen and (max-width: 1380px) {
    .intro .swiper {
        flex-grow: 0;
        height: 540px
    }

    .intro__title {
        font-size: 32px;
        max-width: 80%
    }

    .intro__title .text-primary {
        font-size: 48px
    }

    .intro__bottom {
        flex-wrap: wrap
    }

    .intro__bottom-item {
        flex: 1 0 280px
    }
}

@media screen and (max-width: 1280px) {
    .intro {
        padding-top: 160px
    }

    .intro .container {
        gap: 24px
    }

    .intro__content {
        width: calc(100% - 324px)
    }
}

@media screen and (max-width: 1024px) {
    .intro .aside {
        display: none
    }

    .intro__content {
        width: 100%
    }
}

@media screen and (max-width: 640px) {
    .intro {
        padding-bottom: 20px
    }

    .intro .swiper {
        height: 240px
    }

    .intro .swiper-slide {
        padding: 10px 20px
    }

    .intro .swiper-pagination {
        bottom: 10px;
        left: 20px
    }

    .intro .swiper-pagination-bullet {
        width: 10px;
        height: 10px
    }

    .intro__title {
        font-size: 14px
    }

    .intro__title .text-primary {
        font-size: 20px
    }

    .intro__content {
        gap: 24px
    }

    .intro__bottom {
        gap: 20px
    }

    .intro__bottom-item {
        flex-basis: 160px;
        gap: 15px;
        --icon-size: 30px
    }

    .intro__bottom span {
        font-size: 14px
    }
}

@media screen and (max-width: 475px) {
    .intro .swiper {
        height: 220px
    }
}

.catalog {
    position: relative;
    padding: 35px 0
}

.catalog .top {
    margin-bottom: 22px
}

.catalog__products {
    height: 185px;
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 25px
}

.catalog__product {
    padding: 20px 15px;
    height: 100%;
    flex-grow: 1;
    background: #f9f9f9;
    border-radius: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px
}

.catalog__product img {
    height: 112px;
    width: 100%;
    -o-object-fit: contain;
    object-fit: contain
}

@media screen and (max-width: 640px) {
    .catalog {
        padding: 20px 0;
        overflow: hidden
    }

    .catalog__products {
        height: 140px;
        overflow: visible
    }

    .catalog__product {
        width: 125px
    }

    .catalog__product img {
        width: 60px;
        height: 60px
    }

    .catalog__product span {
        font-size: 14px
    }
}

.offers {
    padding: 35px 0
}

.offers .container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px
}

.offers .text-h2,.h2 {
    font-weight: 300
}

.offers__item {
    position: relative;
    padding: 45px 38px 60px;
    width: 100%;
    height: 385px;
    border-radius: 20px;
    overflow: hidden
}

.offers__item:after {
    content: "";
    position: absolute;
    bottom: 0;
    right: 0;
    height: 100%
}

.offers__item:nth-child(1) {
    background: var(--primary);
    --btn-bg: var(--primary)
}

.offers__item:nth-child(1):after {
    bottom: -5px;
    right: -20px;
    width: 320px;
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/offer-1-bg.webp) center/contain no-repeat
}

.offers__item:nth-child(2) {
    background: var(--cyan);
    --btn-bg: var(--cyan)
}

.offers__item:nth-child(2):after {
    bottom: -10px;
    width: 350px;
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/offer-2-bg.webp) center/contain no-repeat
}

.offers__item .col {
    position: relative;
    height: 100%;
    width: 100%;
    max-width: 325px;
    color: #fff;
    z-index: 2;
    gap: 22px
}

.offers__item .btn {
    margin-top: auto;
    padding: 10px 20px;
    color: var(--btn-bg);
    font-weight: 300;
    background: #fff;
    border-radius: 15px;
    transition: var(--transition)
}

.offers__item .btn:active {
    transform: scale(.95)
}

@media screen and (max-width: 1380px) {
    .offers__item {
        padding: 20px;
        height: auto
    }

    .offers__item:nth-child(1):after {
        bottom: auto;
        top: 50%;
        transform: translateY(-50%);
        width: 200px
    }

    .offers__item:nth-child(2):after {
        width: 200px
    }

    .offers__item .text-h2,.h2 {
        font-size: 20px
    }

    .offers__item .col {
        max-width: 60%
    }
}

@media screen and (max-width: 1024px) {
    .offers .container {
        grid-template-columns: 1fr
    }
}

@media screen and (max-width: 640px) {
    .offers {
        padding: 20px 0
    }

    .offers__item {
        padding: 24px 15px
    }

    .offers__item:nth-child(1):after {
        right: 10px;
        width: 140px
    }

    .offers__item:nth-child(2):after {
        transform: translate(15%)
    }

    .offers__item .col {
        max-width: 65%
    }

    .offers__item .font-light {
        font-size: 14px
    }

    .offers__item .btn {
        font-size: 14px;
        white-space: nowrap
    }
}

.special,
.leaders {
    padding: 35px 0
}

.special .top,
.leaders .top {
