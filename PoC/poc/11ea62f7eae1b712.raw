    }
}

@media screen and (max-width: 1024px) {

    .delivery,
    .contacts {
        padding-bottom: 20px
    }

    .delivery__content,
    .contacts__content {
        flex-direction: column
    }

    .delivery__img,
    .contacts__img {
        width: 100%
    }
}

@media screen and (max-width: 640px) {

    .delivery__content,
    .contacts__content {
        font-size: 14px
    }

    .delivery__content .text-xl,
    .contacts__content .text-xl {
        font-size: 18px
    }

    .delivery__content .col,
    .contacts__content .col {
        margin-top: 24px
    }
}

.payment,
.terms,
.contacts-delivery {
    padding: 35px 0
}

.payment .top,
.terms .top,
.contacts-delivery .top {
    margin-bottom: 38px
}

.payment__content,
.terms__content,
.contacts-delivery__content {
    width: 100%;
    font-weight: 300;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px
}

.payment__content ul,
.terms__content ul,
.contacts-delivery__content ul {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 30px
}

.payment__content ul ol,
.terms__content ul ol,
.contacts-delivery__content ul ol {
    padding-left: 20px;
    list-style: decimal
}

.payment__content ul>li,
.terms__content ul>li,
.contacts-delivery__content ul>li {
    position: relative;
    padding-left: 50px
}

.payment__content ul>li:before,
.terms__content ul>li:before,
.contacts-delivery__content ul>li:before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 25px;
    height: 25px;
    background: url(https://food-fresh.ru/wp-content/themes/foodfresh/assets/img/leaf.svg) center/contain no-repeat
}

.payment__content ul.list,
.terms__content ul.list,
.contacts-delivery__content ul.list {
    padding-left: 20px;
    list-style: disc;
    gap: 0
}

.payment__content ul.list li,
.terms__content ul.list li,
.contacts-delivery__content ul.list li {
    padding-left: 0
}

.payment__content ul.list li:before,
.terms__content ul.list li:before,
.contacts-delivery__content ul.list li:before {
    display: none
}

@media screen and (max-width: 640px) {

    .payment,
    .terms,
    .contacts-delivery {
        padding: 20px 0
    }

    .payment .top,
    .terms .top,
    .contacts-delivery .top {
        margin-bottom: 24px
    }

    .payment__content,
    .terms__content,
    .contacts-delivery__content {
        font-size: 14px
    }

    .payment__content .text-xl,
    .terms__content .text-xl,
    .contacts-delivery__content .text-xl {
        font-size: 18px
    }

    .payment__content ul,
    .terms__content ul,
    .contacts-delivery__content ul {
        gap: 10px
    }

    .payment__content ul>li,
    .terms__content ul>li,
    .contacts-delivery__content ul>li {
        padding-left: 35px;
        font-size: 14px
    }

    .payment__content ul>li:before,
    .terms__content ul>li:before,
    .contacts-delivery__content ul>li:before {
        width: 20px;
        height: 20px
    }
}

.category {
    padding: 165px 0 35px
}

.category__top {
    margin-bottom: 50px;
    position: relative;
    padding: 30px 0;
    color: #fff
}

.category__top .bg-img {
    background: var(--primary)
}

.category__top .breadcrumb {
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    flex-wrap: wrap
}

.category__top .text-h2,.h2 {
    margin-top: 15px
}

.category__wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 45px
}

.category__content {
    width: calc(100% - 345px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 50px
}

.category__list {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px
}

.category__list-item {
    padding: 20px 15px;
    flex-grow: 1;
    background: #f9f9f9;
    border-radius: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px
}

.category__list-item img {
    height: 112px;
    width: 100%;
    -o-object-fit: contain;
    object-fit: contain
}

.category__leaders {
    width: 100%
}

.category__leaders .top {
    margin-bottom: 38px
}

.category__leaders-list {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 25px
}

.category__leaders-item {
    padding: 20px 15px;
    flex-grow: 1;
    border: 1px solid rgba(78, 172, 76, .4);
    border-radius: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-grow: 0;
}

.category__leaders-item img {
    height: 100px;
    width: 100px;
    -o-object-fit: contain;
    object-fit: contain;
    border-radius: 20px
}

.category__leaders-item a {
    padding: 5px 25px;
    color: #fff;
    background: var(--primary);
    border-radius: 12px
}

.category__products {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px
}

.category__products-product {
    position: relative;
    padding: 20px 15px;
    flex-grow: 1;
    border: 1px solid rgba(78, 172, 76, .4);
    border-radius: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px
}

.category__products-product .text-xs {
    position: absolute;
    padding: 2px 14px;
    top: 10px;
    left: 10px;
    color: #fff;
    background: var(--primary);
    border-radius: 8px
}

.category__products-product img {
    height: 100px;
    width: 100px;
    -o-object-fit: contain;
    object-fit: contain;
    border-radius: 20px
}

.category__products-product a {
    padding: 5px 25px;
    color: #fff;
    background: var(--primary);
    border-radius: 12px
}

.category__product {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px
}

.category__product .row {
    align-items: flex-start;
    gap: 45px
}

.category__product .row img {
    width: 455px;
    height: 455px;
    -o-object-fit: contain;
    object-fit: contain
}

.category__product .col {
    margin: auto 0;
    gap: 15px
}

.category__product .col p {
    margin-top: 30px
}

.category__product-table {
    width: 100%;
    overflow: auto
}

.category__product-table table {
    min-width: 580px;
    width: 100%
}

.category__product-table table tr {
    height: 50px
}

.category__product-table table thead {
    color: #fff;
    background: var(--primary)
}

.category__product-table table thead th {
    font-weight: 400;
    white-space: nowrap
}

.category__product-table table thead th:nth-child(1) {
    padding-left: 25px;
    text-align: left
}

.category__product-table table thead th:nth-child(2) {
    text-align: center
}

.category__product-table table thead th:nth-child(3) {
    padding-right: 25px;
    text-align: right
}

.category__product-table table tbody tr:nth-child(2n) {
    background: #e9e9e9
}

.category__product-table table tbody tr td {
    white-space: nowrap
}

.category__product-table table tbody tr td:nth-child(1) {
    padding-left: 25px;
    text-align: left
}

.category__product-table table tbody tr td:nth-child(2) {
    text-align: center
}

.category__product-table table tbody tr td:nth-child(3) {
    padding-right: 5px;
    text-align: right
}

.category__product-table table tbody .btn {
    margin-left: auto;
    padding: 5px 25px;
    width: -webkit-fit-content;
    width: -moz-fit-content;
    width: fit-content;
    color: #fff;
    background: #cd7e22;
    border-radius: 10px
}

@media screen and (max-width: 1380px) {
    .category__list {
        gap: 20px
    }

    .category__product .row {
        flex-direction: column;
        gap: 20px
    }

    .category__product .row img {
        margin: 0 auto;
        width: 100%;
        height: auto;
        max-width: 455px;
        -o-object-fit: contain;
        object-fit: contain
    }
}

@media screen and (max-width: 1280px) {
    .category {
        padding-top: 160px
    }

    .category__list {
        grid-template-columns: repeat(2, 1fr)
    }

    .category__products {
        grid-template-columns: repeat(3, 1fr);
        gap: 20px
    }
}

@media screen and (max-width: 1024px) {
    .category .aside {
        display: none
    }

    .category__content {
        width: 100%
    }

    .category__list {
        grid-template-columns: repeat(4, 1fr)
    }

    .category__list-item img {
        width: 80px;
        height: 80px
    }
}

@media screen and (max-width: 768px) {
    .category__list {
        grid-template-columns: repeat(2, 1fr)
    }
}

@media screen and (max-width: 640px) {
    .category {
        padding-bottom: 20px;
        overflow: hidden
    }

    .category__top {
        padding: 20px 0;
        margin-bottom: 24px
    }

    .category__top .breadcrumb {
        font-size: 14px;
        gap: 5px
    }

    .category__content {
        gap: 24px
    }

    .category__list {
        gap: 10px
    }

    .category__list-item {
        font-size: 14px
    }

    .category__list-item img {
        width: 60px;
        height: 60px
    }

    .category__leaders .top {
        margin-bottom: 24px
    }

    .category__leaders-list {
        overflow: visible
    }

    .category__leaders-item {
        padding: 15px 12px;
        width: 160px;
        font-size: 14px
    }

    .category__leaders-item img {
        width: 80px;
        height: 80px
    }

    .category__leaders-item a {
        padding: 2px 15px;
        border-radius: 10px
    }

    .category__products {
        grid-template-columns: repeat(2, 1fr);
        gap: 15px
    }

    .category__products-product {
        font-size: 14px
    }

    .category__products-product a {
        padding: 5px 15px
    }

    .category__product-table table {
        min-width: 520px
    }

    .category__product-table .btn {
        padding: 5px 10px;
        font-size: 14px
    }
}

@media screen and (max-width: 475px) {
    .category__products {
        gap: 10px
    }

    .category__products-product {
        padding: 25px 15px 15px
    }

    .category__products-product .text-xs {
        top: 7px;
        left: 7px
    }

    .category__products-product img {
        width: 80px;
        height: 80px
    }

    .category__product {
        font-size: 14px
    }

    .category__product .col {
        gap: 10px
    }

    .category__product .col .text-xl {
        font-size: 16px
    }

    .category__product .col p {
        margin-top: 10px
    }
}

@media screen and (max-width: 350px) {
    .category__products {
        gap: 8px
    }

    .category__products-product {
        padding: 12px
    }
}

.buy {
    padding: 35px 0
}

.buy .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 25px
}

.buy__dropdown {
    position: relative;
    max-height: 110px;
    transition: max-height .3s ease-in-out;
    overflow: hidden
}

.buy__dropdown:after {
    position: absolute;
    content: "";
    bottom: 0;
    left: 0;
    height: 75px;
    width: 100%;
    background: linear-gradient(to bottom, transparent, #fff)
}

.buy__dropdown.active:after {
    display: none
}

.buy .btn {
    padding: 5px 25px;
    color: #fff;
    background: var(--primary);
    border-radius: 10px
}

@media screen and (max-width: 640px) {
    .buy {
        padding: 20px 0
    }

    .buy__dropdown {
        font-size: 14px
    }

    .buy .btn {
        padding: 5px 20px;
        font-size: 14px
    }
}

@keyframes showCatalog {
    0% {
        opacity: 0;
        transform: rotateX(-25deg)
    }

    to {
        opacity: 1;
        transform: rotateX(0)
    }
}

@keyframes hideCatalog {
    0% {
        opacity: 1;
        transform: rotateX(0)
    }

    to {
        opacity: 0;
        transform: rotateX(-25deg)
    }
}
span.kb_title {
    font-weight: 400;
}
.kama_breadcrumbs {
    display: flex;
    align-items: center;
    gap: 10px;
}
button.promagnifier {
    display: none;
}
