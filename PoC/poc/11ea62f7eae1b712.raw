        font-size: 24px
    }
}

@media screen and (max-width: 768px) {
    .price-list .content {
        padding: 25px 25% 25px 25px
    }

    .price-list .content:before,
    .price-list .content:after {
        right: 25px;
        width: 200px;
        height: 280px
    }
}

@media screen and (max-width: 640px) {
    .price-list {
        padding: 20px 0
    }

    .price-list .content {
        padding: 20px 35% 20px 16px;
        font-size: 14px
    }

    .price-list .content:before {
        top: calc(50% - 20px);
        right: 5px;
        width: 160px;
        height: 250px
    }

    .price-list .content:after {
        display: none
    }

    .price-list .text-h2,.h2 {
        font-size: 20px
    }

    .price-list .btn {
        padding: 5px 20px;
        font-size: 14px
    }
}

@media screen and (max-width: 380px) {
    .price-list .content:before {
