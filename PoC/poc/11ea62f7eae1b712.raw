<tr>
<td><a href="/bakaleya/">Бакалея</a></td>
<td>151</td>
</tr>
<tr>
<td><a href="/ovoshhi-i-frukty/">Овощи и фрукты</a></td>
<td>115</td>
</tr>
<tr>
<td><a href="/myaso-i-ptica/">Мясо и птица</a></td>
<td>57</td>
</tr>
<tr>
<td><a href="/moreprodukty/">Морепродукты</a></td>
<td>39</td>
</tr>
<tr>
<td><a href="/ryba/">Рыба</a></td>
<td>25</td>
</tr>
<tr>
<td><a href="/kolbasy/">Колбасы</a></td>
<td>18</td>
</tr>
<tr>
<td><a href="/molochnye-produkty/">Молочные продукты</a></td>
<td>16</td>
</tr>
<tr>
<td><a href="/solenya/">Соленья</a></td>
<td>5</td>
</tr>
<tr>
<td><a href="/zamorozka/">Заморозка</a></td>
