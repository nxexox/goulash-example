    background-color: transparent;
    border: none;
    border-radius: 0 0 0 0;
    box-shadow: none;
}
.screen-reader-response{
	display:none;
}
#mobile__search {
    position: fixed;
    bottom: 50%;
    background: #fff;
    z-index: 20;
    width: calc(100% - 30px);
    padding: 15px 0;
    margin: 0 auto;
    left: 50%;
    transform: translate(-50%,-50px);
    border-radius: 20px;
    box-shadow: 0px 10px 68px -3px rgba(0,0,0,0.1);
    color: #000;
	opacity:0;
	pointer-events:none;
	transition: .3s ease-in;
	
}
#mobile__search.active__search{
	opacity:1;
	pointer-events:all;
	 transform: translate(-50%,0);
	transition: .3s ease-in;
}
main.blur{
	    filter: blur(4px);
