        <script>
            function getData(page) {
                $.ajax({
                    method: "POST",
                    url: "https://exhibitors-itegroup.exhibitoronlinemanual.com/ru/Exhibitor/ajaxPaginationData/" + page,
                    data: {
                        page: page
                    },
                    beforeSend: function() {
                        $('.loading').show();
                    },
                    success: function(data) {
                        $('.loading').hide();
                        $('#postList').html(data);
                    }
                });
            }
        </script>
