<script>
$(document).ready(function(e) {
// выпадающий список
$('select').find('option[value*="zal_select=5"]').insertBefore($('select').find('option[value*="zal_select=4"]')); // хак для перестановки местами залов 2.1 и 2.2
$('select').selectize();
