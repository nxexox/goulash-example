<link rel="stylesheet" href="/css/jquery-jvectormap-2.0.1.css" type="text/css" media="screen"/>
<script src="/js/jquery-jvectormap-2.0.3.min.js"></script>
    <script src="/js/jquery-jvectormap-world-mill_mod_rus.js"></script>
<script src="/js/selectize_.js"></script>

<script>
// выпадающий список
$('select').selectize();

function wordend(num, words){
    return words[ ((num=Math.abs(num%100)) > 10 && num < 15 || (num%=10) > 4 || num === 0) ? 2 : num === 1 ? 0 : 1 ];
}


var partData = {"RU":1437};

$('#world-map').vectorMap({

	map: 'world_mill',
	backgroundColor: 'transparent',
	// zoomOnScroll: true,
	// zoomOnScrollSpeed: '10',

	regionStyle: {
		initial: {
		fill: '#C4C7CC',
        // stroke: '#000000'
		}  },

	series: {
		regions: [{
		values: partData, 		fill: '#ddd',
		scale: ['#00599D', '#0070D2'],
		normalizeFunction: 'polynomial'
		}]
	},

	onRegionClick: function(e, code){
		// alert(countryData[code]);
		if (countryData[code])
		{
		var urlParams = new URLSearchParams(window.location.search);
        var terminal = urlParams.get("terminal");
        if (terminal)
        window.location = countryData[code]+"?terminal=";
        else
        window.location = countryData[code];
        }
	},
	onRegionTipShow: function(e, el, code){
		if (partData[code])
		{
                        el.html(el.html()+': '+partData[code]+' '+wordend(partData[code],['участник','участника','участников']));
            		//el.html(el.html()+': '+partData[code]+' '+wordend(partData[code],['участник','участника','участников']));
		}
	}
});

</script>

<!-- скрипты таблицы -->



<script type="text/javascript" src="/js/bootstrap-table_.js"></script>
<script type="text/javascript" src="/js/bootstrap-table-ru-RU.js"></script>
<script type="text/javascript" src="/js/bootstrap-table-cookie.js"></script>
<script type="text/javascript">
 function rowStyle(row, index) {
    return {
      css: {
        background: "#F9F9F9",
        border: "none",

      }
    }
  }
    var $table = $('#my-table'),
        $alertBtn = $('#alertBtn'),
        full_screen = false;

    $().ready(function(){
        $table.bootstrapTable({
            toolbar: ".toolbar",

            showRefresh: false,
            search: false,
            showToggle: false,
            showColumns: false,
            pagination: true,
            //sidePagination: 'client',
            striped: false,
            sortable: false,
            pageSize: 10,
            pageList: [10,25,50,100],

            //cardView: function () {
            //if (($( ).width()) < 700) {return true} else {return false}},

            formatShowingRows: function(pageFrom, pageTo, totalRows){
                //do nothing here, we don't want to show the text "showing x of y from..."
            },
            formatRecordsPerPage: function(pageNumber){
                return "показывать по " + pageNumber;
            },
            icons: {
                refresh: 'fa fa-refresh',
                toggle: 'glyphicon-th-list',
                columns: 'glyphicon-cog',
                detailOpen: 'fa fa-plus-circle',
                detailClose: 'fa fa-minus-circle'
            }
        });


    function setup_for_width(mql) {
        if (mql.matches) {
        $table.bootstrapTable('refreshOptions',{cardView:true});
        } else {
            $table.bootstrapTable('refreshOptions',{cardView:false});
        }
    }
    var mql = window.matchMedia("screen and (max-width: 670px)");
    mql.addListener(setup_for_width); // Добавим прослушку на смену результата
    setup_for_width(mql); // Вызовем нашу функцию

    $("dt:contains(Рубрики)").addClass("category");
    $("dt:contains(Рубрики)").next("dd").addClass("category");

    // tooltip
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>

